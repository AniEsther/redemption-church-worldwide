# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/redemption-church
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/redemption-church
MONGO_URI=mongodb://127.0.0.1:27017/redemption-church

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign admin JWTs — change this to a long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin` to create the first admin account
ADMIN_EMAIL=admin@redemptionchurchworldwide.org
ADMIN_PASSWORD=change-this-password

# Cloudinary — for storing uploaded photos/audio/PDFs in the cloud instead of
# local disk. Leave all three blank to use local disk (fine for development,
# NOT recommended for production — most hosts wipe local files on redeploy).
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications — sends the admin an email when someone submits the
# contact form or a prayer request. Leave blank to disable notifications
# (submissions still save to the database either way — this is just the alert).
# Works with Gmail (use an "App Password", not your real password —
# see https://myaccount.google.com/apppasswords) or any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=admin@redemptionchurchworldwide.org


